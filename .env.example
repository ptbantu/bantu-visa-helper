# ============================================
# 应用配置
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:8081

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=file:./prisma/dev.db

# ============================================
# 阿里云 Qwen VL API（PDF 识别）
# ============================================
QWEN_VL_API_KEY=your_qwen_vl_api_key_here

# ============================================
# 邮件配置（IMAP）
# ============================================
EMAIL_ACCOUNT=your_email@example.com
EMAIL_PASSWORD=your_email_password_here
EMAIL_FILTER=@imigrasi.go.id
EMAIL_FREQUENCY_MINUTES=5

# ============================================
# 企业微信配置（可选）
# ============================================
WECOM_WEBHOOK_URL=your_wecom_webhook_url_here

# ============================================
# WeChat企微通知配置（可选）
# ============================================
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key

# ============================================
# 语音机器人配置（可选）
# ============================================
VOICE_BOT_API_KEY=your_voice_bot_api_key_here
VOICE_CALL_TIME=working-hours
VOICE_RECEIVER=wangshuo

# ============================================
# 阿里云 OSS 配置
# ============================================
# 获取凭证: https://ram.console.aliyun.com/manage/ak
OSS_ENDPOINT=oss-ap-southeast-5.aliyuncs.com
OSS_BUCKET_NAME=bantuqifu-dev
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
