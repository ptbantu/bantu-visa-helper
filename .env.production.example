# 生产环境变量配置
# 复制此文件为 .env.production 并填入实际值

# Node 环境
NODE_ENV=production

# 数据库
DATABASE_URL=file:./prisma/prod.db

# 应用 URL
NEXT_PUBLIC_API_URL=https://www.bantuqifu.online/visa

# 邮件配置（如果需要）
# IMAP_HOST=
# IMAP_PORT=
# IMAP_USER=
# IMAP_PASSWORD=

# OSS 配置（如果需要）
# ALI_OSS_REGION=
# ALI_OSS_ACCESS_KEY_ID=
# ALI_OSS_ACCESS_KEY_SECRET=
# ALI_OSS_BUCKET=

# Google Gemini API（如果需要）
# GOOGLE_GENAI_API_KEY=

# 其他配置
# LOG_LEVEL=info
# DEBUG=false
