# ============================================
# Docker 环境配置 - Supabase 后端
# ============================================

# 应用配置
FRONTEND_PORT=3000
NODE_ENV=production

# 应用 URL
APP_URL=http://localhost:3000

# ============================================
# AI API 密钥
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
QWEN_VL_API_KEY=your_qwen_vl_api_key_here

# ============================================
# Supabase 配置（必需）
# ============================================
# 从 Supabase 项目设置中获取
DATABASE_URL=your_supabase_database_url_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# Redis 配置（可选）
# ============================================
# 如果使用外部 Redis 服务，配置这里
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# 备注
# ============================================
# 1. DATABASE_URL: Supabase 提供的 PostgreSQL 连接字符串
#    格式: postgresql://[user]:[password]@[host]:[port]/[database]
#
# 2. SUPABASE_URL: Supabase 项目 URL（来自项目设置）
#
# 3. SUPABASE_ANON_KEY: Supabase 匿名密钥（来自项目设置）
#
# 4. 所有敏感信息不要提交到 git，请使用本地 .env 文件覆盖
