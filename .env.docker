# ============================================
# Docker 环境配置 - Bantu Visa Helper
# ============================================

# 应用配置
FRONTEND_PORT=3000
NODE_ENV=production

# 应用 URL
APP_URL=http://localhost:8081
NEXT_PUBLIC_APP_URL=http://localhost:8081

# ============================================
# 数据库配置（SQLite）
# ============================================
# SQLite 数据库文件路径
DATABASE_URL=file:./prisma/dev.db

# ============================================
# AI API 密钥
# ============================================
# 阿里云 Qwen VL API 密钥（用于 PDF 识别）
QWEN_VL_API_KEY=sk-46d01c1601c949e285a47756ec844afd

# ============================================
# 邮件配置（IMAP）
# ============================================
# 邮箱账户
EMAIL_ACCOUNT=your_email@example.com

# 邮箱密码或应用密码
EMAIL_PASSWORD=your_email_password_here

# 邮件过滤条件（用于筛选特定邮件）
EMAIL_FILTER=@imigrasi.go.id

# 邮件检查频率（分钟）
EMAIL_FREQUENCY_MINUTES=5

# ============================================
# 企业微信配置（可选）
# ============================================
# 企业微信 Webhook URL（用于推送通知）
WECOM_WEBHOOK_URL=your_wecom_webhook_url_here

# ============================================
# 语音机器人配置（可选）
# ============================================
# 语音机器人 API 密钥
VOICE_BOT_API_KEY=your_voice_bot_api_key_here

# 语音通话时间（working-hours 或 24-hours）
VOICE_CALL_TIME=working-hours

# 语音通话接收人
VOICE_RECEIVER=wangshuo

# ============================================
# 阿里云 OSS 配置
# ============================================
# OSS Endpoint（根据地区选择）
# 新加坡: oss-ap-southeast-5.aliyuncs.com
# 杭州: oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=oss-ap-southeast-5.aliyuncs.com

# OSS Bucket 名称
OSS_BUCKET_NAME=bantuqifu-dev

# OSS Access Key ID
# 获取凭证: https://ram.console.aliyun.com/manage/ak
OSS_ACCESS_KEY_ID=your_access_key_id

# OSS Access Key Secret
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# ============================================
# 备注
# ============================================
# 1. DATABASE_URL: SQLite 数据库文件路径
#    格式: file:./prisma/dev.db
#
# 2. EMAIL_ACCOUNT 和 EMAIL_PASSWORD: 用于 IMAP 邮件接收
#    建议使用应用专用密码而不是账户密码
#
# 3. QWEN_VL_API_KEY: 用于 PDF 文件的 OCR 识别
#    从阿里云控制台获取
#
# 4. 所有敏感信息不要提交到 git，请使用本地 .env 文件覆盖
#
